# msb-manager environment — install as /etc/msb-manager/env, root:root 0600.
# Only MSB_MANAGER_TOKEN is required; everything else has a safe default.

# REQUIRED. The single bearer token guarding every endpoint except
# /healthz and /readyz. Generate one with: openssl rand -hex 32
MSB_MANAGER_TOKEN=replace-me

# Bind address. Loopback by default — Caddy is the only external listener
# (CLAUDE.md invariant). Only change the port, never the interface, without
# a new ADR.
#MSB_MANAGER_LISTEN_ADDR=127.0.0.1:8080

# Path to the msb binary if it is not on the service user's PATH.
#MSB_MANAGER_MSB_PATH=/usr/local/bin/msb

# Filesystem state root (reserved for future use; systemd's StateDirectory
# creates it).
#MSB_MANAGER_DATA_DIR=/var/lib/msb-manager

# Per-msb-invocation timeout: a positive Go duration, at most 90s
# (default 60s). Bounds a hung msb so it can't wedge the mutating mutex.
#MSB_MANAGER_CMD_TIMEOUT=60s
